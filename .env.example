DATABASE_URL=sqlite:///./job_radar.db
HTTP_USER_AGENT=JobRadarMVP/0.2 (+personal job search; contact: your@email.com)

HH_USER_AGENT=JobRadarMVP/0.2 (your@email.com)
HH_SEARCH_TEXT=event manager OR event producer OR менеджер мероприятий OR спецпроекты
HH_AREA=1

# Register an app on api.superjob.ru to enable this source.
SUPERJOB_API_KEY=
SUPERJOB_KEYWORD=event manager
SUPERJOB_TOWN=Москва

# Scheduler
ENABLED_SOURCES=hh,eventru,geekjob,habr,superjob
SYNC_LIMIT_PER_SOURCE=30
SCHEDULER_ENABLED=true
SYNC_INTERVAL_MINUTES=10

# Optional semantic scoring. Without a key, heuristic + feedback learning remain active.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
LLM_ENABLED=true
LLM_MIN_HEURISTIC_SCORE=45
LLM_WEIGHT=0.65
